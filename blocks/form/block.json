{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "libreforms/form",
	"title": "Form",
	"category": "libreforge",
	"icon": "feedback",
	"description": "Shows a form made in LibreForms.",
	"keywords": [
		"form",
		"contact",
		"submit"
	],
	"textdomain": "libreforms",
	"attributes": {
		"formId": {
			"type": "number",
			"default": 0
		}
	},
	"supports": {
		"html": false,
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true
		},
		"color": {
			"text": true,
			"background": true
		}
	},
	"editorScript": "libreforms-blocks",
	"style": "libreforms"
}
